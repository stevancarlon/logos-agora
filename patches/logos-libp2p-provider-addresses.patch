diff --git i/libp2p/protocols/kademlia/provider.nim w/libp2p/protocols/kademlia/provider.nim
index 2158339..eda327f 100644
--- i/libp2p/protocols/kademlia/provider.nim
+++ w/libp2p/protocols/kademlia/provider.nim
@@ -519,7 +519,19 @@ proc getProviders*(
       if PeerId.init(idraw).isErr:
         debug "Invalid peer id received", peerId = provider.id
         continue
-      allProviders.incl(provider)
+      # Peer equality compares only the id. Keep addresses learned from every
+      # responding DHT node: the first response may contain an expired relay.
+      var merged = provider
+      for previous in allProviders:
+        if previous == provider:
+          for address in previous.addrs:
+            if address notin merged.addrs and merged.addrs.len < 32:
+              merged.addrs.add(address)
+          break
+      if merged.addrs.len > 32:
+        merged.addrs.setLen(32)
+      allProviders.excl(provider)
+      allProviders.incl(merged)
 
   let enoughProviders = proc(state: LookupState): bool {.gcsafe.} =
     allProviders.len() >= kad.config.replication
