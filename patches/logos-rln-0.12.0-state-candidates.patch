@@ -0,0 +1,40 @@
+//! Keep membership-state selection consistent with proof selection. Historical
+//! records must not make a single usable replacement ambiguous. If none are
+//! usable, retain records so callers can still report pending/terminal states.
+
+pub(crate) fn prefer_usable<T>(records: Vec<T>, usable: impl Fn(&T) -> bool) -> Vec<T> {
+    if records.iter().any(&usable) {
+        records.into_iter().filter(usable).collect()
+    } else {
+        records
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[derive(Debug, PartialEq, Eq)]
+    enum State { Active, Grace, Erased, Expired, Pending, Failed }
+    fn candidates(records: Vec<State>) -> Vec<State> {
+        prefer_usable(records, |s| matches!(s, State::Active | State::Grace))
+    }
+    #[test]
+    fn erased_legacy_record_does_not_block_active_replacement() {
+        assert_eq!(candidates(vec![State::Erased, State::Active]), vec![State::Active]);
+        assert_eq!(candidates(vec![State::Active, State::Erased]), vec![State::Active]);
+    }
+    #[test]
+    fn only_usable_candidates_survive_when_a_replacement_exists() {
+        assert_eq!(candidates(vec![State::Expired, State::Pending, State::Failed, State::Grace]), vec![State::Grace]);
+    }
+    #[test]
+    fn multiple_usable_records_remain_ambiguous() {
+        assert_eq!(candidates(vec![State::Erased, State::Active, State::Grace]), vec![State::Active, State::Grace]);
+    }
+    #[test]
+    fn no_usable_record_preserves_diagnostic_states() {
+        assert_eq!(candidates(vec![State::Pending]), vec![State::Pending]);
+        assert_eq!(candidates(vec![State::Erased, State::Failed]), vec![State::Erased, State::Failed]);
+        assert!(candidates(vec![]).is_empty());
+    }
+}
