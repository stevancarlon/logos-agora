diff --git i/storage/blockexchange/engine/swarm.nim w/storage/blockexchange/engine/swarm.nim
index f74592b..5c30501 100644
--- i/storage/blockexchange/engine/swarm.nim
+++ w/storage/blockexchange/engine/swarm.nim
@@ -123,7 +123,19 @@ proc addPeer*(swarm: Swarm, peerId: PeerId, availability: BlockAvailability): bo
   if peerId in swarm.removedPeers:
     return false
   if swarm.peers.len >= swarm.config.deltaMax:
-    return false
+    # Initial discovery can fill the swarm with unknown peers. Make room for
+    # a peer that actually advertises content, otherwise its positive presence
+    # responses are ignored forever and the download cannot make progress.
+    if availability.kind == bakUnknown:
+      return false
+    var replace = none(PeerId)
+    for candidate, existing in swarm.peers:
+      if existing.availability.kind == bakUnknown:
+        replace = some(candidate)
+        break
+    if replace.isNone:
+      return false
+    swarm.peers.del(replace.get())
   swarm.peers[peerId] = SwarmPeer.new(availability)
   true
 
diff --git i/storage/blockexchange/network/network.nim w/storage/blockexchange/network/network.nim
index dd80215..f40d2e7 100644
--- i/storage/blockexchange/network/network.nim
+++ w/storage/blockexchange/network/network.nim
@@ -14,6 +14,7 @@ import std/sets
 import pkg/chronos
 
 import pkg/libp2p
+import pkg/libp2p/protocols/connectivity/relay/relay
 import pkg/libp2p/connmanager as lp_connmanager
 import pkg/libp2p/protocols/protocol as lp_protocol
 import pkg/questionable
@@ -301,6 +302,12 @@ proc dialPeer*(self: BlockExcNetwork, peer: PeerRecord) {.async.} =
   else:
     await self.switch.connect(peer.peerId, peer.addresses.mapIt(it.address))
 
+proc isRelayPeer*(self: BlockExcNetwork, peer: PeerId): bool =
+  if self.isMixDownload or self.switch.isNil:
+    return false
+  let connections = self.switch.connManager.getConnections().getOrDefault(peer)
+  connections.len > 0 and connections.allIt(isRelayed(it.connection))
+
 proc dropPeer*(
     self: BlockExcNetwork, peer: PeerId
 ) {.async: (raises: [CancelledError]).} =
@@ -324,6 +331,18 @@ proc dropPeer*(
   except CatchableError as error:
     warn "Error attempting to disconnect from peer", peer = peer, error = error.msg
 
+proc renewRelay*(self: BlockExcNetwork, peer: PeerId, reconnect: bool) {.async: (raises: [CancelledError]).} =
+  let addresses = self.switch.peerStore[AddressBook][peer]
+  await self.dropPeer(peer)
+  if reconnect and addresses.len > 0:
+    try:
+      await self.switch.connect(peer, addresses).wait(10.seconds)
+    except CancelledError as exc:
+      raise exc
+    except CatchableError as exc:
+      trace "Relay renewal failed; discovery will retry", peer, error = exc.msg
+
+
 proc excludeRelays*(self: BlockExcNetwork, peers: openArray[PeerId]) =
   for p in peers:
     self.excludedPeers.incl(p)
diff --git i/storage/blockexchange/utils.nim w/storage/blockexchange/utils.nim
index db2e51e..b8b4c4e 100644
--- i/storage/blockexchange/utils.nim
+++ w/storage/blockexchange/utils.nim
@@ -49,6 +49,9 @@ func isIndexInRanges*(
 proc computeBatchSize*(blockSize: uint32): uint32 =
   doAssert blockSize > 0, "computeBatchSize requires blockSize > 0"
   let
-    optimal = TargetBatchBytes div blockSize
+    # Leave room for framing, proofs and multiplexing beneath the default
+    # 128 KiB circuit-relay allowance. A 128 KiB payload cannot fit even on a
+    # fresh circuit, so retrying that same batch can never make progress.
+    optimal = min(TargetBatchBytes, 64'u32 * 1024) div blockSize
     maxFromBytes = MaxWantBlocksResponseBytes div blockSize
   return clamp(optimal, MinBatchSize, maxFromBytes)
