-    return false
+    # Initial discovery can fill the swarm with unknown peers. Make room for
+    # a peer that actually advertises content, otherwise its positive presence
+    # responses are ignored forever and the download cannot make progress.
+    if availability.kind == bakUnknown:
+      return false
+    var replace = none(PeerId)
+    for candidate, existing in swarm.peers:
