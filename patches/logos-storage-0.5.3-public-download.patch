diff --git a/storage/utils/directconnect.nim b/storage/utils/directconnect.nim
new file mode 100644
index 0000000..1ed5700
--- /dev/null
+++ b/storage/utils/directconnect.nim
@@ -0,0 +1,46 @@
+## Bound each advertised address so an expired relay cannot consume the entire
+## peer dial budget before a working address is attempted.
+{.push raises: [].}
+
+import std/[strutils, algorithm]
+import pkg/chronos
+import pkg/libp2p
+import ../logutils
+
+logScope:
+  topics = "storage directconnect"
+
+proc connectDirect*(
+    switch: Switch, peer: PeerId, addresses: seq[MultiAddress]
+) {.async: (raises: [CancelledError, DialFailedError]).} =
+  var lastError = "No usable direct address"
+  # Reuse addresses that actually worked before trying unverified DHT entries.
+  # Identify can report the same expired relay first on every renewed circuit.
+  let book = switch.peerStore[AddressBook]
+  let live = book[peer]
+  var known = book.entries(peer)
+  known.sort(proc(a, b: AddressEntry): int = cmp(b.lastUpdated, a.lastUpdated))
+  var candidates: seq[MultiAddress]
+  for entry in known:
+    if entry.confidence >= AddressConfidence.High and entry.address in live:
+      candidates.add(entry.address)
+  for address in addresses:
+    if address notin candidates:
+      candidates.add(address)
+  let deadline = Moment.now() + 25.seconds
+  for address in candidates:
+    # Mix endpoints require their own authenticated Mix transport.
+    if "/mix-transport/" in $address:
+      continue
+    let remaining = deadline - Moment.now()
+    if remaining <= ZeroDuration:
+      break
+    try:
+      await switch.connect(peer, @[address]).wait(min(8.seconds, remaining))
+      return
+    except CancelledError as exc:
+      raise exc
+    except CatchableError as exc:
+      lastError = exc.msg
+      trace "Address failed; trying next", peer, address, error = lastError
+  raise newException(DialFailedError, lastError)
