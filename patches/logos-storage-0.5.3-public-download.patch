diff --git i/tests/storage/blockexchange/engine/testswarm.nim w/tests/storage/blockexchange/engine/testswarm.nim
index 0e30cbd..bbaf39b 100644
--- i/tests/storage/blockexchange/engine/testswarm.nim
+++ w/tests/storage/blockexchange/engine/testswarm.nim
@@ -243,6 +243,33 @@ suite "Swarm":
     check removed.isSome
     check swarm.getPeer(peerId).isNone
 
+  test "content provider replaces an unknown peer in a full swarm":
+    let config = SwarmConfig(deltaMin: 1, deltaMax: 2, deltaTarget: 2)
+    swarm = Swarm.new(config)
+    let provider = PeerId.example
+    check swarm.addPeer(PeerId.example, BlockAvailability.unknown())
+    check swarm.addPeer(PeerId.example, BlockAvailability.unknown())
+    check swarm.addPeer(provider,
+      BlockAvailability.fromRanges(@[IndexRange(start: 0'u64, count: 9'u64)]))
+    check swarm.peerCount() == 2
+    check provider in swarm.peersWithRange(0, 9)
+
+  test "unknown peers cannot displace known providers":
+    let config = SwarmConfig(deltaMin: 1, deltaMax: 1, deltaTarget: 1)
+    swarm = Swarm.new(config)
+    let provider = PeerId.example
+    check swarm.addPeer(provider, BlockAvailability.complete())
+    check not swarm.addPeer(PeerId.example, BlockAvailability.unknown())
+    check provider in swarm.peersWithRange(0, 9)
+
+  test "banned provider cannot displace unknown peers":
+    let config = SwarmConfig(deltaMin: 1, deltaMax: 1, deltaTarget: 1)
+    swarm = Swarm.new(config)
+    let provider = PeerId.example
+    swarm.banPeer(provider)
+    check swarm.addPeer(PeerId.example, BlockAvailability.unknown())
+    check not swarm.addPeer(provider, BlockAvailability.complete())
+
   test "banPeer prevents re-adding":
     let peerId = PeerId.example
     discard swarm.addPeer(peerId, BlockAvailability.complete())
