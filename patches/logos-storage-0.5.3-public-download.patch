diff --git a/tests/storage/testdirectconnect.nim b/tests/storage/testdirectconnect.nim
new file mode 100644
index 0000000..be9093d
--- /dev/null
+++ b/tests/storage/testdirectconnect.nim
@@ -0,0 +1,50 @@
+import pkg/chronos
+import pkg/libp2p except setup, eventually
+import pkg/storage/utils/directconnect
+import ../asynctest
+import ./helpers
+
+asyncchecksuite "Direct provider connection fallback":
+  var
+    provider, reader: Switch
+    stalled: StreamServer
+    accepted: seq[StreamTransport]
+
+  proc acceptWithoutHandshake(server: StreamServer, transport: StreamTransport) {.async: (raises: []).} =
+    accepted.add(transport)
+
+  setup:
+    provider = newStandardSwitch()
+    reader = newStandardSwitch()
+    await provider.start()
+    await reader.start()
+    stalled = createStreamServer(initTAddress("127.0.0.1", 0), acceptWithoutHandshake, {ReuseAddr})
+    stalled.start()
+
+  teardown:
+    for transport in accepted:
+      await transport.closeWait()
+    stalled.stop()
+    await stalled.closeWait()
+    await reader.stop()
+    await provider.stop()
+    accepted.setLen(0)
+
+  test "Falls through an unresponsive first address to a working provider":
+    let stale = MultiAddress.init("/ip4/127.0.0.1/tcp/" & $stalled.localAddress.port).tryGet()
+    let started = Moment.now()
+    await reader.connectDirect(provider.peerInfo.peerId, @[stale] & provider.peerInfo.addrs).wait(12.seconds)
+    check:
+      accepted.len == 1
+      Moment.now() - started < 12.seconds
+    await reader.disconnect(provider.peerInfo.peerId)
+    # The successful address is now preferred over the same stalled entry.
+    await reader.connectDirect(provider.peerInfo.peerId, @[stale] & provider.peerInfo.addrs).wait(3.seconds)
+    check accepted.len == 1
+
+  test "Cancellation stops an in-flight connection attempt":
+    let stale = MultiAddress.init("/ip4/127.0.0.1/tcp/" & $stalled.localAddress.port).tryGet()
+    let pending = reader.connectDirect(provider.peerInfo.peerId, @[stale])
+    await sleepAsync(100.millis)
+    await pending.cancelAndWait()
+    check pending.cancelled()
